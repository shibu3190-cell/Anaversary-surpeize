rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() > 0 && id.size() <= 64;
    }

    function isValidSurprise(data) {
      return data.keys().hasAll(['title', 'password', 'photos', 'createdAt'])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.password is string && data.password.size() > 0
        && data.photos is list && data.photos.size() >= 1
        && data.createdAt is number;
    }

    match /surprises/{surpriseId} {
      allow get: if isValidId(surpriseId);
      allow create: if isValidId(surpriseId) && isValidSurprise(request.resource.data);
      allow update: if isValidId(surpriseId);
      allow list: if false;
      allow delete: if false;
    }
  }
}
